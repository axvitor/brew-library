rules_version = '2';

// Paste this into: Firebase console → Firestore Database → Rules tab → Publish.
//
// Sign-in is open to anyone with a Google account. There's no allowlist —
// every signed-in user gets their own document under libraries/{uid} and
// can only ever read or write that one. Nobody can read anyone else's.
service cloud.firestore {
  match /databases/{database}/documents {

    match /libraries/{uid} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid;
    }
  }
}
